# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default (the demo uses gpt-5.6-luna), and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-luna,gpt-5.4-mini,gpt-5-mini
# Tokens per minute your OpenAI key allows for the first model; the assistant waits instead of failing when a burst would exceed it.
OPENAI_TPM=1500000

# Postgres (Neon). `neon env pull` fills these in.
# DATABASE_URL is pooled (app traffic); DATABASE_URL_UNPOOLED is direct (migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Currency of the organization's PayPal account (USD, CAD, EUR, GBP, AUD). Defaults to CAD.
NEXT_PUBLIC_ORG_CURRENCY=CAD

# Public address of this app, no trailing slash. The QR codes (counter and live display) send the supporter's
# phone here, so it must be reachable from a phone: use the Vercel URL, not localhost.
NEXT_PUBLIC_APP_URL=

# PayPal webhook id (Sandbox app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# giveback platform sandbox account: sender of cashback payouts (a different account from the merchant)
PAYOUT_CLIENT_ID=
PAYOUT_CLIENT_SECRET=
PAYOUT_PLATFORM_EMAIL=
PAYOUT_COOLDOWN_DAYS=30
PAYOUT_MIN_CENTS=2500
# Webhook id of the platform app (Events: Payouts batch + item). Payout events go to this app, not the merchant app.
PAYOUT_WEBHOOK_ID=
# Where cashback is sent unless changed in Settings (the sandbox merchant account email).
PAYOUT_RECIPIENT_EMAIL=

# platform = supporters pay the giveback platform account and the vendor is settled through Payouts (needs PAYOUT_*). direct = supporters pay the vendor account straight.
CHECKOUT_MODE=direct
# Sandbox personal account that receives the sample sponsor invoices (so the loop can be opened and paid)
SPONSOR_DEMO_EMAIL=sb-0he9w53817163@personal.example.com
